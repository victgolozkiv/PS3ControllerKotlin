<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- PKG Installer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📦 Instalador de PKG"
                android:textColor="@color/neon_purple"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sube juegos o aplicaciones (.pkg) en segundo plano a /dev_hdd0/packages/"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnUploadPkg"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="📂 Seleccionar y Subir PKG"
                android:background="@drawable/bg_button_pkg"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <!-- PKG Progress Container -->
            <LinearLayout
                android:id="@+id/layoutPkgProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_dark"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvPkgFileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="archivo.pkg"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="middle"/>

                    <TextView
                        android:id="@+id/tvPkgProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarPkg"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/bg_progress_custom"
                    android:max="100"
                    android:progress="0"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="La subida continúa en segundo plano con notificación viva."
                    android:textColor="@color/text_muted"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Game Mount Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📀 Montar y Ejecutar Juego"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etMountPath"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ruta del juego (ej: /dev_hdd0/GAMES/BLES01234)"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnMountGame"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="▶ Montar Juego"
                    android:background="@drawable/bg_button_green"
                    app:backgroundTint="@null"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnUnmountGame"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="⏹ Desmontar"
                    android:background="@drawable/bg_button_red"
                    app:backgroundTint="@null"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
