<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- ═══════════════════════════════════════════════════════
         FUTURISTIC HEADER BAR (Branding + Status)
         ═══════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp"
        android:background="#0A0E1A">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 PS3"
                android:textColor="@color/neon_cyan"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" CONTROLLER"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" PRO"
                android:textColor="@color/neon_purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_button_dark"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <!-- Connection Status Badge -->
        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_disconnected"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="🔴 Desconectado"
            android:textColor="@color/neon_red"
            android:textSize="11sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════
         SWIPEABLE TAB NAVIGATION BAR (TabLayout)
         ═══════════════════════════════════════════════════════ -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#0A0E1A"
        app:tabMode="scrollable"
        app:tabIndicatorColor="@color/neon_cyan"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/neon_cyan"
        app:tabTextColor="@color/text_secondary"
        app:tabRippleColor="#2000E5FF"/>

    <!-- ═══════════════════════════════════════════════════════
         VIEW PAGER 2 (Horizontal Swipe Pages)
         ═══════════════════════════════════════════════════════ -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
</LinearLayout>
