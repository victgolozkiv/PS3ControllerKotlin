<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TV Notification Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📺 Notificación Emergente en Pantalla TV"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muestra un mensaje flotante en la TV mientras juegas o ves películas"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etPopupMsg"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Escribe un mensaje para la pantalla TV..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSendPopup"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="📺 Enviar Mensaje a Pantalla TV"
                android:background="@drawable/bg_button_cyan"
                app:backgroundTint="@null"
                android:textColor="#0B0E17"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Fan Control Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌀 Ajuste Manual de Ventilador (SYSCON)"
                    android:textColor="@color/neon_purple"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvFanVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="40%"
                    android:textColor="@color/neon_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <SeekBar
                android:id="@+id/sbFanSpeed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="40"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnSetFan"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🌀 Aplicar Velocidad del Ventilador"
                android:background="@drawable/bg_button_theme"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>

        <!-- Buzzer Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊 Alarma / Pitido (Buzzer)"
                android:textColor="@color/neon_yellow"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnBuzzer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="🔊 Emitir Pitido Doble en PS3"
                android:background="@drawable/bg_button_dark"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
