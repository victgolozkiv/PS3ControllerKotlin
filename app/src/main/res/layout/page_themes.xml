<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Card 1: Temas Animados (.p3t) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🎨 Temas Animados (.p3t)"
                    android:textColor="@color/neon_purple"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PS3 THEME"
                    android:textColor="@color/neon_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_dark"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sube temas animados (.p3t) directamente a /dev_hdd0/theme/ por FTP"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp"/>

            <Button
                android:id="@+id/btnUploadTheme"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🎨 Seleccionar y Subir Tema (.p3t)"
                android:background="@drawable/bg_button_theme"
                app:backgroundTint="@null"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <!-- Theme Upload Progress -->
            <LinearLayout
                android:id="@+id/layoutThemeProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_dark"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvThemeFileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="tema.p3t"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="middle"/>

                    <TextView
                        android:id="@+id/tvThemeProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarTheme"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/bg_progress_custom"
                    android:max="100"
                    android:progress="0"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 2: Fondos de Pantalla (JPG/PNG) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🖼️ Fondos de Pantalla (Imágenes)"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sube imágenes (JPG, PNG) a tu consola PS3"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etWallpaperPath"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Ruta de destino (ej: /dev_hdd0/theme/)"
                android:text="/dev_hdd0/theme/"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="14dp"
                android:textSize="13sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnUploadWallpaper"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:text="🖼️ Seleccionar y Subir Fondo (JPG/PNG)"
                android:background="@drawable/bg_button_cyan"
                app:backgroundTint="@null"
                android:textColor="#0B0E17"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <!-- Wallpaper Progress Container -->
            <LinearLayout
                android:id="@+id/layoutWallpaperProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_button_dark"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:id="@+id/tvWallpaperFileName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="fondo.jpg"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:singleLine="true"
                        android:ellipsize="middle"/>

                    <TextView
                        android:id="@+id/tvWallpaperProgressPercent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0%"
                        android:textColor="@color/neon_cyan"
                        android:textSize="13sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/progressBarWallpaper"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:progressDrawable="@drawable/bg_progress_custom"
                    android:max="100"
                    android:progress="0"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Card 3: Guía PS3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 Aplicar Temas (.p3t) en PS3"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1️⃣ Subida directa por App (FTP):\n- Sube tu tema .p3t arriba y se guardará en /dev_hdd0/theme/.\n- En tu PS3 ve a Ajustes > Ajustes de Temas > Tema y selecciónalo.\n\n2️⃣ Instalación vía USB (FAT32):\n- En tu USB crea la carpeta: PS3/THEME/\n- Copia el archivo .p3t en la carpeta THEME.\n- En tu PS3 ve a Ajustes > Ajustes de Temas > Tema > Instalar."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:background="@drawable/bg_button_dark"
                android:padding="12dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
