<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Connection Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐 Conexión a PS3"
                android:textColor="@color/neon_cyan"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etPs3Ip"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="IP de la PS3 (ej: 192.168.0.120)"
                android:text="192.168.0.120"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:inputType="textUri"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="⚡ Conectar a PS3"
                android:background="@drawable/bg_button_cyan"
                app:backgroundTint="@null"
                android:textColor="#0B0E17"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tvConnectionFeedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingresa la IP de tu PS3 con webMAN / FTP habilitado."
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Telemetry Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📊 Telemetría del Sistema"
                    android:textColor="@color/neon_cyan"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/swAutoRefresh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Auto 5s"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"/>
            </LinearLayout>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:rowCount="2">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_button_dark"
                    android:padding="12dp"
                    android:layout_margin="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CPU Temp"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvCpuTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 -- °C"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_button_dark"
                    android:padding="12dp"
                    android:layout_margin="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RSX Temp"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvRsxTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ -- °C"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_button_dark"
                    android:padding="12dp"
                    android:layout_margin="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ventilador"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvFanSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌀 -- %"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_columnWeight="1"
                    android:orientation="vertical"
                    android:background="@drawable/bg_button_dark"
                    android:padding="12dp"
                    android:layout_margin="4dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Disco Libre"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"/>
                    <TextView
                        android:id="@+id/tvFreeHdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💾 -- GB"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </GridLayout>
        </LinearLayout>

        <!-- Power Controls Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_ios"
            android:padding="18dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔌 Control de Energía"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnReboot"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🔄 Reiniciar"
                    android:background="@drawable/bg_button_dark"
                    app:backgroundTint="@null"
                    android:textColor="#FFB74D"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnShutdown"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🛑 Apagar"
                    android:background="@drawable/bg_button_red"
                    app:backgroundTint="@null"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
